{
  "name": "slopnuke",
  "version": "0.4.0",
  "description": "Sweep a repo's code comments, markdown, code strings and test names for AI writing slop with SlopSift, and have the agent rewrite each finding until a rescan is clean.",
  "author": {
    "name": "redacktion"
  },
  "homepage": "https://github.com/redacktion/slopnuke",
  "repository": "https://github.com/redacktion/slopnuke",
  "license": "MIT",
  "keywords": [
    "writing",
    "linting",
    "slopsift",
    "hooks"
  ],
  "mcpServers": {
    "slopnuke": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/slopnuke.ts",
        "mcp"
      ]
    }
  }
}
